{
  "name": "satrapit/opgateway",
  "description": "Security-first Openprovider API gateway",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "doctrine/dbal": "^4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "OPGateway\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OPGateway\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "lint": "@php scripts/lint.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
