# Owned by OPGateway and deployed only to /assets/admin/.htaccess.
# The cPanel-managed Document Root .htaccess is never replaced.
# Asset URLs use sha256 content versions (v=...), so a new build gets a new URL.
# Do not apply these headers to authenticated HTML, PHP or API responses.
<IfModule mod_headers.c>
<FilesMatch "^(app\\.css|app\\.js|theme-init\\.js|icons\\.svg)$">
Header onsuccess unset Cache-Control
Header always unset Cache-Control
Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<IfModule mod_mime.c>
AddType image/svg+xml .svg
</IfModule>
