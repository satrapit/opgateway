{% extends 'layouts/account-auth.html.twig' %}
{% block account_form %}
  {% if show_error %}<div class="opg-alert opg-alert-error mb-6" role="alert">Verification failed. Please try the new challenge.</div>{% endif %}
  <p class="mb-6 text-sm text-gray-600 dark:text-gray-300">Recovery also works for Google-only accounts. The email link lets you establish a local password if you lose Google access.</p>
  <form method="post" action="/account/forgot-password" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div><label class="opg-label" for="forgot-email">Email address</label>
    <input class="opg-input" id="forgot-email" name="email" type="email" maxlength="254" autocomplete="email" required></div>
    {% if captcha.mode|default('') == 'offline' %}
      <div><label class="opg-label" for="forgot-captcha">Enter the six characters shown</label>
        <div class="opg-captcha-frame mb-3 overflow-hidden rounded-lg border border-gray-200 bg-gray-100 dark:border-gray-700">
          <img class="opg-captcha-image" src="{{ captcha.image_url }}" width="300" height="106" alt="Image verification challenge with six characters" draggable="false" loading="eager">
        </div>
        <a href="/account/forgot-password" class="mb-3 inline-block text-sm text-brand-600 hover:underline dark:text-brand-300">Get a new image</a>
        <input type="hidden" name="captcha_id" value="{{ captcha.challenge_id }}">
        <input class="opg-input" id="forgot-captcha" name="captcha_answer" inputmode="text" pattern="[A-Za-z2-9]{6}" minlength="6" maxlength="6" autocapitalize="characters" spellcheck="false" autocomplete="off" required>
      </div>
    {% elseif captcha.mode|default('') == 'recaptcha' %}
      <div class="g-recaptcha" data-sitekey="{{ captcha.site_key }}"></div>
    {% endif %}
    <button type="submit" class="opg-primary-button w-full">Send reset link</button>
  </form>
  {% if captcha.mode|default('') == 'recaptcha' %}<script src="https://www.google.com/recaptcha/api.js" async defer></script>{% endif %}
  <p class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400"><a class="font-semibold text-brand-600 hover:underline dark:text-brand-300" href="/account/login">Back to sign in</a></p>
{% endblock %}
