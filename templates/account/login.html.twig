{% extends 'layouts/account-auth.html.twig' %}
{% block account_form %}
  {% if show_error %}
    <div class="opg-alert opg-alert-error mb-6" role="alert" id="account-login-error">Sign-in failed. Check your details and verification, then try again.</div>
  {% endif %}
  <form method="post" action="/account/login" autocomplete="on" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div>
      <label class="opg-label" for="owner-email">Email address</label>
      <input class="opg-input" id="owner-email" name="email" type="email" maxlength="254" autocomplete="username" required{% if show_error %} aria-describedby="account-login-error"{% endif %}>
    </div>
    <div>
      <label class="opg-label" for="owner-password">Password</label>
      <input class="opg-input" id="owner-password" name="password" type="password" maxlength="1024" autocomplete="current-password" required{% if show_error %} aria-describedby="account-login-error"{% endif %}>
    </div>
    {% if allow_registration %}
    <div class="text-right"><a class="text-sm font-semibold text-brand-600 hover:underline dark:text-brand-300" href="/account/forgot-password">Forgot password?</a></div>
    {% endif %}
    {% if captcha.mode|default('') == 'offline' %}
      <div>
        <label class="opg-label" for="account-captcha">Enter the six characters shown</label>
        <div class="mb-3 overflow-hidden rounded-lg border border-gray-200 bg-gray-100 dark:border-gray-700">
          <img src="{{ captcha.image_url }}" width="300" height="106" alt="Image verification challenge with six characters" draggable="false" loading="eager">
        </div>
        <a href="/account/login" class="mb-3 inline-block text-sm text-brand-600 hover:underline dark:text-brand-300">Get a new image</a>
        <input type="hidden" name="captcha_id" value="{{ captcha.challenge_id }}">
        <input class="opg-input" id="account-captcha" name="captcha_answer" inputmode="text" pattern="[A-Za-z2-9]{6}" minlength="6" maxlength="6" autocapitalize="characters" spellcheck="false" autocomplete="off" required>
      </div>
    {% elseif captcha.mode|default('') == 'recaptcha' %}
      <div class="g-recaptcha" data-sitekey="{{ captcha.site_key }}"></div>
    {% endif %}
    <button type="submit" class="opg-primary-button w-full">Sign in</button>
  </form>
  {% if captcha.mode|default('') == 'recaptcha' %}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  {% endif %}
  {% if google_available %}
    <div class="my-6 flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
      <span class="h-px flex-1 bg-gray-200 dark:bg-gray-700"></span>or<span class="h-px flex-1 bg-gray-200 dark:bg-gray-700"></span>
    </div>
    <a href="/account/google/start" class="opg-secondary-button flex w-full items-center justify-center gap-3" rel="nofollow"><span aria-hidden="true" class="font-bold">G</span> Continue with Google</a>
    <p class="mt-3 text-center text-xs text-gray-500 dark:text-gray-400">First connect your Google account in Account settings. Email and password sign-in remain available.</p>
  {% endif %}
  {% if allow_registration %}
    <p class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">New to OPGateway? <a class="font-semibold text-brand-600 hover:underline dark:text-brand-300" href="/account/register">Create an account</a></p>
  {% endif %}
{% endblock %}
