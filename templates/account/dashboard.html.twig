{% extends 'layouts/account.html.twig' %}
{% block dashboard_content %}
<section id="overview" class="mb-7" aria-labelledby="owner-overview-title">
  <div class="opg-panel p-6 sm:p-8">
    <p class="mb-2 text-sm font-semibold text-brand-600 dark:text-brand-300">Account overview</p>
    <h2 id="owner-overview-title" class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-3xl">Welcome to OPGateway</h2>
    <p class="mt-3 min-w-0 break-all text-sm text-gray-500 dark:text-gray-400">Signed in as {{ overview.email }}</p>
    <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">Manage your Openprovider account, request access for API clients and review your approved IP addresses.</p>
    <div class="mt-7 grid min-w-0 grid-cols-1 gap-4 sm:grid-cols-3">
      <a class="opg-stat-card" href="#clients"><span class="opg-muted block">API clients</span><span class="mt-3 block text-3xl font-semibold tabular-nums">{{ overview.clients|length }}</span></a>
      <a class="opg-stat-card" href="#keys"><span class="opg-muted block">API keys</span><span class="mt-3 block text-3xl font-semibold tabular-nums">{{ overview.credentials|length }}</span></a>
      <a class="opg-stat-card" href="#ips"><span class="opg-muted block">IP entries</span><span class="mt-3 block text-3xl font-semibold tabular-nums">{{ overview.ips|length }}</span></a>
    </div>
  </div>
</section>

{% if integration_enabled %}
<section id="provider" class="mb-7 opg-panel p-6 sm:p-8" aria-labelledby="provider-title">
  <div class="mb-6 flex min-w-0 flex-wrap items-start justify-between gap-3">
    <div>
      <p class="mb-1 text-sm font-semibold text-brand-600 dark:text-brand-300">Provider integration</p>
      <h2 id="provider-title" class="opg-section-title">Openprovider account</h2>
      <p class="opg-section-subtitle">Your reseller password is encrypted at rest and never displayed again.</p>
    </div>
    <span class="opg-badge {{ provider.configured|default(false) ? 'opg-badge-green' : 'opg-badge-amber' }}">{{ provider.configured|default(false) ? 'Configured' : 'Not configured' }}</span>
  </div>
  <form method="post" action="/account/provider/save" class="grid min-w-0 gap-5 sm:grid-cols-2" autocomplete="off">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div>
      <label class="opg-label" for="provider-username">Openprovider API username</label>
      <input class="opg-input" id="provider-username" name="username" value="{{ provider.username|default('') }}" maxlength="254" autocomplete="off" required>
    </div>
    <div>
      <label class="opg-label" for="provider-password">Openprovider API password</label>
      <input class="opg-input" id="provider-password" name="password" type="password" maxlength="1024" autocomplete="new-password" required>
    </div>
    <div class="sm:col-span-2">
      <label class="opg-label" for="provider-confirm-password">Confirm your gateway account password</label>
      <input class="opg-input" id="provider-confirm-password" name="current_password" type="password" maxlength="1024" autocomplete="current-password" required>
    </div>
    <div class="sm:col-span-2">
      <button class="opg-primary-button w-full sm:w-auto" type="submit">Save encrypted credentials</button>
    </div>
  </form>
</section>
{% endif %}

<section id="clients" class="mb-7 opg-panel" aria-labelledby="clients-title">
  <div class="opg-panel-header">
    <div>
      <h2 id="clients-title" class="opg-section-title">Your API clients</h2>
      <p class="opg-section-subtitle">New clients stay disabled until an administrator approves them.</p>
    </div>
    <span class="opg-count">{{ overview.clients|length }} clients</span>
  </div>
  {% if overview.clients is empty %}
    <p class="opg-empty">No API clients yet. Create your first client below.</p>
  {% else %}
    <div class="grid min-w-0 gap-4 p-4 sm:grid-cols-2 sm:p-6">
      {% for client in overview.clients %}
      <article class="opg-record-card">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="opg-record-title">{{ client.label }}</p>
            <p class="opg-muted mt-1">Client #{{ client.id }}</p>
          </div>
          <span class="opg-badge {{ client.status == 'active' ? 'opg-badge-green' : 'opg-badge-amber' }}">{{ client.status }}</span>
        </div>
        {% if keys_enabled and client.status == 'active' %}
        <form method="post" action="/account/keys/issue" class="mt-5 space-y-3 border-t border-gray-200 pt-4 dark:border-gray-800">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}">
          <input type="hidden" name="client_id" value="{{ client.id }}">
          <label class="opg-label" for="confirm-{{ client.id }}">Confirm your password to issue a key</label>
          <input class="opg-input" id="confirm-{{ client.id }}" type="password" name="password" maxlength="1024" autocomplete="current-password" required>
          <button type="submit" class="opg-small-button w-full sm:w-auto">Issue new key</button>
        </form>
        {% else %}
          <p class="opg-muted mt-4">API keys become available after client activation.</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  {% endif %}
  {% if integration_enabled %}
  <form method="post" action="/account/clients/create" class="border-t border-gray-200 p-5 sm:p-6 dark:border-gray-800">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <label class="opg-label" for="client-label">Request a new API client</label>
    <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center">
      <input class="opg-input min-w-0 flex-1" id="client-label" name="label" maxlength="128" placeholder="Client name" required>
      <button type="submit" class="opg-secondary-button shrink-0">Request client</button>
    </div>
  </form>
  {% endif %}
</section>

<section id="keys" class="mb-7 opg-panel" aria-labelledby="keys-title">
  <div class="opg-panel-header">
    <div>
      <h2 id="keys-title" class="opg-section-title">API key prefixes</h2>
      <p class="opg-section-subtitle">Key secrets appear only once after issuance. Only prefixes are listed here.</p>
    </div>
    <span class="opg-count">{{ overview.credentials|length }} keys</span>
  </div>
  {% if overview.credentials is empty %}
    <p class="opg-empty">No API keys issued yet.</p>
  {% else %}
    <div class="grid min-w-0 gap-3 p-4 md:grid-cols-2 sm:p-6">
      {% for credential in overview.credentials %}
      <article class="opg-record-card">
        <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="opg-record-title">Client #{{ credential.client_id }} · key #{{ credential.id }}</p>
            <p class="mt-2 break-all font-mono text-sm text-gray-600 dark:text-gray-300">{{ credential.prefix }}</p>
          </div>
          <span class="opg-badge {{ credential.revoked ? 'opg-badge-neutral' : 'opg-badge-green' }}">{{ credential.revoked ? 'Revoked / expired' : 'Active' }}</span>
        </div>
        {% if keys_enabled and not credential.revoked %}
          <form method="post" action="/account/keys/revoke" class="mt-4">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="client_id" value="{{ credential.client_id }}">
            <input type="hidden" name="credential_id" value="{{ credential.id }}">
            <button type="submit" class="opg-danger-button">Revoke key</button>
          </form>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

<section id="ips" class="mb-7 opg-panel" aria-labelledby="ips-title">
  <div class="opg-panel-header">
    <div>
      <h2 id="ips-title" class="opg-section-title">Allowed source IPs</h2>
      <p class="opg-section-subtitle">Only exact IPs approved for an active client may access the API.</p>
    </div>
    <span class="opg-count">{{ overview.ips|length }} IP entries</span>
  </div>
  {% if overview.ips is empty %}
    <p class="opg-empty">No IP requests yet.</p>
  {% else %}
    <div class="grid min-w-0 gap-3 p-4 sm:grid-cols-2 sm:p-6">
      {% for ip in overview.ips %}
      <div class="opg-record-card flex min-w-0 flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="opg-record-title break-all">{{ ip.address }}</p>
          <p class="opg-muted mt-1">Client #{{ ip.client_id }}</p>
        </div>
        <span class="opg-badge {{ ip.enabled ? 'opg-badge-green' : 'opg-badge-amber' }}">{{ ip.enabled ? 'Approved' : 'Pending' }}</span>
      </div>
      {% endfor %}
    </div>
  {% endif %}
  {% if integration_enabled and overview.clients is not empty %}
    <div class="border-t border-gray-200 p-5 sm:p-6 dark:border-gray-800">
      <h3 class="mb-3 text-sm font-semibold text-gray-900 dark:text-white">Request IP approval</h3>
      <div class="grid min-w-0 gap-5 md:grid-cols-2">
      {% for client in overview.clients %}
        <form method="post" action="/account/ips/request" class="min-w-0 space-y-3">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}">
          <input type="hidden" name="client_id" value="{{ client.id }}">
          <label class="opg-label" for="requested-ip-{{ client.id }}">IP for client {{ client.label }} (#{{ client.id }})</label>
          <input class="opg-input" id="requested-ip-{{ client.id }}" name="ip" maxlength="45" placeholder="203.0.113.42" required>
          <button type="submit" class="opg-secondary-button w-full sm:w-auto">Request IP approval</button>
        </form>
      {% endfor %}
      </div>
    </div>
  {% endif %}
</section>
{% endblock %}
