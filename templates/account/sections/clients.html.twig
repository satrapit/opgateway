<section id="clients" class="mb-7 opg-panel" aria-labelledby="clients-title">
  <div class="opg-panel-header">
    <div>
      <h2 id="clients-title" class="opg-section-title">Your API clients</h2>
      <p class="opg-section-subtitle">New clients stay disabled until an administrator approves them.</p>
    </div>
    <span class="opg-count">{{ overview.clients|length }} clients</span>
  </div>
  {% if overview.clients is empty %}
    <p class="opg-empty">No API clients yet. Create your first client below.</p>
  {% else %}
    <div class="grid min-w-0 gap-4 p-4 sm:grid-cols-2 sm:p-6">
      {% for client in overview.clients %}
      <article class="opg-record-card">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="opg-record-title">{{ client.label }}</p>
            <p class="opg-muted mt-1">Client #{{ client.id }}</p>
          </div>
          <span class="opg-badge {{ client.status == 'active' ? 'opg-badge-green' : 'opg-badge-amber' }}">{{ client.status }}</span>
        </div>
        {% if keys_enabled and client.status == 'active' %}
        <form method="post" action="/account/keys/issue" class="mt-5 space-y-3 border-t border-gray-200 pt-4 dark:border-gray-800">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}">
          <input type="hidden" name="client_id" value="{{ client.id }}">
          <label class="opg-label" for="confirm-{{ client.id }}">Confirm your password to issue a key</label>
          <input class="opg-input" id="confirm-{{ client.id }}" type="password" name="password" maxlength="1024" autocomplete="current-password" required>
          <button type="submit" class="opg-small-button w-full sm:w-auto">Issue new key</button>
        </form>
        {% else %}
          <p class="opg-muted mt-4">API keys become available after client activation.</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  {% endif %}
  {% if integration_enabled %}
  <form method="post" action="/account/clients/create" class="border-t border-gray-200 p-5 sm:p-6 dark:border-gray-800">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <label class="opg-label" for="client-label">Request a new API client</label>
    <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-center">
      <input class="opg-input min-w-0 flex-1" id="client-label" name="label" maxlength="128" placeholder="Client name" required>
      <button type="submit" class="opg-secondary-button shrink-0">Request client</button>
    </div>
  </form>
  {% endif %}
</section>
