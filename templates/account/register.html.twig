{% extends 'layouts/account-auth.html.twig' %}
{% block account_form %}
  <form method="post" action="/account/register" class="space-y-5" autocomplete="on">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div>
      <label class="opg-label" for="registration-email">Email address</label>
      <input class="opg-input" id="registration-email" name="email" type="email" maxlength="254" autocomplete="email" required>
    </div>
    <div>
      <label class="opg-label" for="registration-password">Password</label>
      <input class="opg-input" id="registration-password" name="password" type="password" minlength="12" maxlength="1024" autocomplete="new-password" required>
      <p class="opg-muted mt-2">Use a password with at least 12 characters.</p>
    </div>
    <button type="submit" class="opg-primary-button w-full">Register and send verification email</button>
  </form>
  <section class="mt-8 border-t border-gray-200 pt-7 dark:border-gray-800" aria-labelledby="resend-title">
    <h2 id="resend-title" class="opg-section-title mb-2">Resend verification email</h2>
    <p class="opg-section-subtitle mb-4">Didn't receive your link? Request a new one.</p>
    <form method="post" action="/account/verify/resend" class="space-y-4">
      <input type="hidden" name="_csrf" value="{{ csrf_token }}">
      <label class="opg-label" for="resend-email">Email address</label>
      <input class="opg-input" id="resend-email" name="email" type="email" maxlength="254" autocomplete="email" required>
      <button type="submit" class="opg-secondary-button w-full">Resend verification</button>
    </form>
  </section>
  <p class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">Already registered? <a class="font-semibold text-brand-600 hover:underline dark:text-brand-300" href="/account/login">Sign in</a></p>
{% endblock %}
