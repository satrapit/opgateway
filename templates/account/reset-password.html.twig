{% extends 'layouts/account-auth.html.twig' %}
{% block account_form %}
  <form method="post" action="/account/reset-password" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <input type="hidden" name="token" value="{{ token }}">
    <div><label class="opg-label" for="new-password">New password</label>
    <input class="opg-input" id="new-password" name="password" type="password" minlength="12" maxlength="1024" autocomplete="new-password" required>
    <p class="opg-muted mt-2">At least 12 characters.</p></div>
    <div><label class="opg-label" for="new-password-confirm">Confirm new password</label>
    <input class="opg-input" id="new-password-confirm" name="password_confirmation" type="password" minlength="12" maxlength="1024" autocomplete="new-password" required></div>
    <button type="submit" class="opg-primary-button w-full">Reset password</button>
  </form>
{% endblock %}
