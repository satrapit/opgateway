{% extends 'layouts/admin.html.twig' %}
{% block dashboard_content %}
<section class="opg-panel p-6 sm:p-8" aria-labelledby="login-settings-title">
  <h2 id="login-settings-title" class="opg-section-title">Login settings</h2>
  <p class="opg-section-subtitle">Manage each sign-in option on its own page.</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <a href="/admin/settings/login/google" class="opg-panel block p-5">
      <h3 class="font-semibold text-gray-900 dark:text-white">Google SSO</h3>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{% if google.secret_set %}Client credentials saved{% else %}Not configured{% endif %}</p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Client ID, Client Secret and enable/disable.</p>
    </a>
    <a href="/admin/settings/login/captcha" class="opg-panel block p-5">
      <h3 class="font-semibold text-gray-900 dark:text-white">CAPTCHA</h3>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{% if captcha.provider == 'offline' %}Offline challenge{% else %}Google reCAPTCHA v2{% endif %}</p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Select one method for password sign-in.</p>
    </a>
  </div>
  <div class="opg-alert mt-6" role="note">Email/password sign-in remains available independently of Google SSO. Password recovery uses the Email / SMTP settings.</div>
</section>
{% endblock %}
