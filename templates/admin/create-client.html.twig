{% extends 'layouts/admin.html.twig' %}
{% block dashboard_content %}
<section class="opg-panel p-6 sm:p-8" aria-labelledby="create-client-title">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="create-client-title" class="opg-section-title">Create API client</h2>
      <p class="opg-section-subtitle">Create a disabled client for an approved account owner.</p>
    </div>
    <a href="/admin/clients" class="opg-secondary-button">Back to clients</a>
  </div>
  {% if owners is empty %}
    <div class="opg-alert" role="status">No eligible owners found. <a href="/admin/users/invite" class="font-semibold text-brand-600">Invite a user</a> first.</div>
  {% else %}
    <form method="post" action="/admin/clients/create" class="grid max-w-xl gap-5">
      <input type="hidden" name="_csrf" value="{{ csrf_token }}">
      <div>
        <label class="opg-label" for="new-client-owner">Account owner</label>
        <select class="opg-input" name="target_id" id="new-client-owner" required>
          <option value="">Select an approved owner</option>
          {% for owner in owners %}
            <option value="{{ owner.id }}">{{ owner.email }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label class="opg-label" for="new-client-label">Client name</label>
        <input class="opg-input" name="value" id="new-client-label" maxlength="128" required>
      </div>
      <button type="submit" class="opg-primary-button">Create client</button>
    </form>
  {% endif %}
  <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">New clients start disabled. Activate a client after review, then approve exact IP addresses before API requests can be accepted.</p>
</section>
{% endblock %}
