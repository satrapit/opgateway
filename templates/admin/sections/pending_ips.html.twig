{% import 'components/forms.html.twig' as action %}
{% import 'components/records.html.twig' as record %}
<section id="pending-ips" aria-labelledby="pending-ips-title" class="opg-panel">
  <div class="opg-panel-header">
    <div>
      <h2 id="pending-ips-title" class="opg-section-title">Pending IP allowlist requests</h2>
      <p class="opg-section-subtitle">Only exact IPv4 or IPv6 entries; approval is separate from request creation.</p>
    </div>
    <span class="opg-count">{{ queues.ips|length }} shown</span>
  </div>
  {% if queues.ips is empty %}
  <p class="opg-empty" role="status">No pending IP requests for active clients.</p>
  {% else %}
  <div class="opg-record-grid" role="list" aria-label="Pending IP requests cards">
    {% for ip in queues.ips %}
    <article class="opg-record-card" role="listitem">
      <div class="flex min-w-0 items-start justify-between gap-3">
        <div class="min-w-0"><p class="opg-record-title font-mono">{{ ip.address }}</p><p class="opg-muted mt-1">Client: {{ ip.client_label }}</p></div>
        <span class="opg-badge opg-badge-amber shrink-0">Pending</span>
      </div>
      <div class="opg-record-actions">
<details class="opg-row-menu" data-opg-row-menu>
  <summary class="opg-row-menu-trigger" aria-label="More options for {{ ip.address }}" title="More options for {{ ip.address }}" data-tooltip="More options"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-ellipsis-vertical"></use></svg></summary>
  <div class="opg-action-popover" aria-label="Options for {{ ip.address }}">

        {{ record.details('IP', ip.address, [
  {label:'IP address', value:ip.address},
  {label:'Client', value:ip.client_label},
  {label:'Approval', value:'Pending'}
]) }}{% if actions_enabled %}{{ action.review(csrf_token, 'approve_ip', ip.id, 'Approve IP') }}{% else %}<span class="opg-muted">Read only</span>{% endif %}
  </div>
</details>
</div>
    </article>
    {% endfor %}
  </div>
  <div class="opg-table-wrap opg-desktop-table" tabindex="0" role="region" aria-label="Pending IP requests table">
    <table class="opg-table">
      <thead><tr><th scope="col">IP address</th><th scope="col">Client</th><th scope="col">Status</th><th scope="col" class="text-end">Action</th></tr></thead>
      <tbody>
      {% for ip in queues.ips %}
      <tr>
        <td class="font-mono text-sm">{{ ip.address }}</td><td>{{ ip.client_label }}</td><td><span class="opg-badge opg-badge-amber">Pending</span></td>
        <td class="text-end"><details class="opg-row-menu" data-opg-row-menu>
  <summary class="opg-row-menu-trigger" aria-label="More options for {{ ip.address }}" title="More options for {{ ip.address }}" data-tooltip="More options"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-ellipsis-vertical"></use></svg></summary>
  <div class="opg-action-popover" aria-label="Options for {{ ip.address }}">
{{ record.details('IP', ip.address, [
  {label:'IP address', value:ip.address},
  {label:'Client', value:ip.client_label},
  {label:'Approval', value:'Pending'}
]) }} {% if actions_enabled %}{{ action.review(csrf_token, 'approve_ip', ip.id, 'Approve IP') }}{% else %}<span class="opg-muted">Read only</span>{% endif %}
  </div>
</details>
</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
