{% import 'components/forms.html.twig' as action %}
{% import 'components/records.html.twig' as record %}
<section id="owners" aria-labelledby="owners-title" class="opg-panel">
  <div class="opg-panel-header">
    <div>
      <h2 id="owners-title" class="opg-section-title">Approved account owners</h2>
      <p class="opg-section-subtitle">Create a disabled client for an approved owner. Activation is a separate step.</p>
    </div>
    <span class="opg-count">{{ queues.owners|length }} shown</span>
  </div>
  {% if queues.owners is empty %}
  <p class="opg-empty" role="status">No approved account owners were found in this listing.</p>
  {% else %}
  <div class="opg-record-grid" role="list" aria-label="Approved account owners cards">
    {% for owner in queues.owners %}
    <article class="opg-record-card" role="listitem">
      <div class="flex min-w-0 items-start justify-between gap-3">
        <div class="min-w-0"><p class="opg-record-title">{{ owner.email }}</p><p class="opg-muted mt-1">User #{{ owner.id }}</p></div>
        <span class="opg-badge opg-badge-green shrink-0">Approved</span>
      </div>
      <div class="opg-record-actions">
<details class="opg-row-menu" data-opg-row-menu>
  <summary class="opg-row-menu-trigger" aria-label="More options for {{ owner.email }}" title="More options for {{ owner.email }}" data-tooltip="More options"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-ellipsis-vertical"></use></svg></summary>
  <div class="opg-action-popover" aria-label="Options for {{ owner.email }}">

        {{ record.details('Owner', owner.email, [
  {label:'User ID', value:owner.id},
  {label:'Email', value:owner.email},
  {label:'Approval', value:'Approved'}
]) }}{% if actions_enabled %}{{ action.provision(csrf_token, 'create_client', owner.id, 'Create client', 'Client name', 'New client label', 128, 'mobile') }}{% else %}<span class="opg-muted">Read only</span>{% endif %}
  </div>
</details>
</div>
    </article>
    {% endfor %}
  </div>
  <div class="opg-table-wrap opg-desktop-table" tabindex="0" role="region" aria-label="Approved owners table">
    <table class="opg-table">
      <thead><tr><th scope="col">Account owner</th><th scope="col">Status</th><th scope="col">Client provisioning</th></tr></thead>
      <tbody>
      {% for owner in queues.owners %}
      <tr>
        <td><div class="font-medium text-gray-900 dark:text-white">{{ owner.email }}</div><span class="opg-muted">User #{{ owner.id }}</span></td>
        <td><span class="opg-badge opg-badge-green">Approved</span></td>
        <td><details class="opg-row-menu" data-opg-row-menu>
  <summary class="opg-row-menu-trigger" aria-label="More options for {{ owner.email }}" title="More options for {{ owner.email }}" data-tooltip="More options"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-ellipsis-vertical"></use></svg></summary>
  <div class="opg-action-popover" aria-label="Options for {{ owner.email }}">
{{ record.details('Owner', owner.email, [
  {label:'User ID', value:owner.id},
  {label:'Email', value:owner.email},
  {label:'Approval', value:'Approved'}
]) }} {% if actions_enabled %}{{ action.provision(csrf_token, 'create_client', owner.id, 'Create client', 'Client name', 'New client label') }}{% else %}<span class="opg-muted">Read only</span>{% endif %}
  </div>
</details>
</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>
