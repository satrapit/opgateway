{% extends 'layouts/auth.html.twig' %}
{% block title %}Administrator sign in{% endblock %}
{% block content %}
<div class="grid min-h-screen lg:grid-cols-2" x-data="adminShell">
  <main id="main-content" class="relative flex items-center justify-center px-4 py-16 sm:px-8 lg:px-12">
    <button type="button" class="opg-icon-button opg-theme-toggle absolute end-4 top-4 sm:end-6 sm:top-6" x-on:click="cycleTheme" x-bind:aria-label="themeControlLabel" x-bind:title="themeControlLabel" aria-label="Change color theme" title="Change color theme">
          <i data-lucide="monitor" class="opg-icon opg-theme-icon" data-theme-icon="system" aria-hidden="true"></i>
          <i data-lucide="sun" class="opg-icon opg-theme-icon" data-theme-icon="light" aria-hidden="true"></i>
          <i data-lucide="moon" class="opg-icon opg-theme-icon" data-theme-icon="dark" aria-hidden="true"></i>
          <span class="opg-sr-only" x-text="themeLabel">System</span>
        </button>
    <div class="w-full max-w-md">
      <div class="mb-10 inline-flex items-center gap-3">
        <span class="flex size-11 items-center justify-center rounded-xl bg-brand-500 text-xl font-bold text-white" aria-hidden="true">O</span>
        <span class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">OPGateway</span>
      </div>
      <p class="mb-2 text-sm font-semibold text-brand-600 dark:text-brand-300">Administrator workspace</p>
      <h1 class="mb-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">Sign in to your account</h1>
      <p class="mb-8 text-sm leading-6 text-gray-500 dark:text-gray-400">Authorized operators only. Your session is protected and limited to approved source addresses.</p>
      {% if show_error %}
        <div class="opg-alert opg-alert-error mb-6" role="alert" id="login-error">Sign-in was not successful. Check your credentials and try again.</div>
      {% endif %}
      <form method="post" action="/admin/login" autocomplete="on" class="space-y-5">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <div>
          <label class="opg-label" for="email">Email address</label>
          <input class="opg-input" id="email" name="email" type="email" maxlength="254" autocomplete="username" required{% if show_error %} aria-describedby="login-error"{% endif %}>
        </div>
        <div>
          <label class="opg-label" for="password">Password</label>
          <input class="opg-input" id="password" name="password" type="password" autocomplete="current-password" required{% if show_error %} aria-describedby="login-error"{% endif %}>
        </div>
        <button class="opg-primary-button w-full" type="submit">Sign in securely</button>
      </form>
      <p class="mt-8 text-center text-xs text-gray-500 dark:text-gray-400">Only authenticated and pre-approved administrators can enter.</p>
    </div>
  </main>
  <aside class="hidden items-center justify-center bg-brand-950 px-12 text-white lg:flex" aria-label="About the workspace">
    <div class="max-w-md">
      <div class="mb-8 flex size-16 items-center justify-center rounded-2xl bg-brand-500 text-3xl font-bold shadow-lg">O</div>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-brand-200">Secure by design</p>
      <h2 class="mb-5 text-4xl font-semibold leading-tight">One workspace.<span class="block text-brand-300">Controlled access.</span></h2>
      <p class="max-w-sm leading-7 text-brand-100">Review account access, client activation, and exact IP allowlists from one carefully guarded operator console.</p>
      <div class="mt-9 flex flex-wrap gap-3 text-sm">
        <span class="rounded-full border border-brand-300/40 px-4 py-2">HTTPS required</span>
        <span class="rounded-full border border-brand-300/40 px-4 py-2">Trusted IP only</span>
      </div>
    </div>
  </aside>
</div>
{% endblock %}
