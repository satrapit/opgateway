{% extends 'layouts/admin.html.twig' %}
{% block title %}Administration{% endblock %}
{% block admin_content %}
<header class="mb-7">
  <h1 class="text-2xl font-semibold tracking-tight text-gray-900 sm:text-3xl dark:text-white">OPGateway administration</h1>
  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Signed in as {{ display_email }}</p>
</header>

{% if not has_overview %}
  <div role="status" class="rounded-xl border border-gray-200 bg-white p-6 text-sm text-gray-700 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-200">Management features are not yet configured.</div>
{% else %}
  <div class="mb-7 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {% for metric in [
      { label: 'Pending users', count: queues.users|length, target: '#users' },
      { label: 'Account owners', count: queues.owners|length, target: '#owners' },
      { label: 'API clients', count: queues.clients|length, target: '#clients' },
      { label: 'Pending IPs', count: queues.ips|length, target: '#ips' }
    ] %}
      <a href="{{ metric.target }}" class="rounded-2xl border border-gray-200 bg-white p-4 shadow-theme-xs transition-shadow hover:shadow-theme-sm focus-visible:outline-3 focus-visible:outline-brand-500 sm:p-5 dark:border-gray-800 dark:bg-gray-900">
        <p class="text-xs font-medium text-gray-500 sm:text-sm dark:text-gray-400">{{ metric.label }}</p>
        <p class="mt-3 text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">{{ metric.count }}</p>
        <p class="mt-2 text-xs text-gray-400">Records shown · max 50</p>
      </a>
    {% endfor %}
  </div>
  <div role="status" class="mb-7 rounded-xl border px-4 py-3 text-sm {{ actions_enabled ? 'border-brand-200 bg-brand-50 text-brand-800 dark:border-brand-900 dark:bg-brand-950 dark:text-brand-200' : 'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200' }}">
    {% if actions_enabled %}
      Review actions are enabled. All changes require a secure form POST and fresh server authorization.
    {% else %}
      Review queues are read-only. Administrative actions remain disabled by policy.
    {% endif %}
  </div>
  <div class="grid gap-6">
    {% include 'components/admin/queue.html.twig' with { section_id: 'users', heading: 'Verified users awaiting approval', kind: 'users', items: queues.users, actions_enabled: actions_enabled, csrf_token: csrf_token } only %}
    {% include 'components/admin/queue.html.twig' with { section_id: 'owners', heading: 'Approved account owners', kind: 'owners', items: queues.owners, actions_enabled: actions_enabled, csrf_token: csrf_token } only %}
    {% include 'components/admin/queue.html.twig' with { section_id: 'clients', heading: 'API clients and IP provisioning', kind: 'clients', items: queues.clients, actions_enabled: actions_enabled, csrf_token: csrf_token } only %}
    {% include 'components/admin/queue.html.twig' with { section_id: 'ips', heading: 'Pending IP allowlist requests', kind: 'ips', items: queues.ips, actions_enabled: actions_enabled, csrf_token: csrf_token } only %}
    {% if show_approved_ips %}
      {% include 'components/admin/queue.html.twig' with { section_id: 'approved-ips', heading: 'Approved IP allowlist entries', kind: 'approved_ips', items: queues.approved_ips, actions_enabled: actions_enabled, csrf_token: csrf_token } only %}
    {% endif %}
  </div>
{% endif %}
{% endblock %}
