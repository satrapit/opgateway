{% extends 'layouts/admin.html.twig' %}
{% block dashboard_content %}
<section class="opg-panel p-6 sm:p-8" aria-labelledby="request-ip-title">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="request-ip-title" class="opg-section-title">Request IP access</h2>
      <p class="opg-section-subtitle">Request an exact address for an active client. Approval is a separate action.</p>
    </div>
    <a href="/admin/ips/pending" class="opg-secondary-button">Back to IP requests</a>
  </div>
  <form method="post" action="/admin/ips/request" class="grid max-w-xl gap-5">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <div>
      <label class="opg-label" for="request-ip-client">Active API client</label>
      <select class="opg-input" name="target_id" id="request-ip-client" required>
        <option value="">Select a client</option>
        {% for client in clients %}
          {% if client.status == 'active' %}
            <option value="{{ client.id }}">{{ client.label }} · {{ client.owner_email }}</option>
          {% endif %}
        {% endfor %}
      </select>
    </div>
    <div>
      <label class="opg-label" for="request-ip-address">IPv4 or IPv6 address</label>
      <input class="opg-input" name="value" id="request-ip-address" maxlength="45" placeholder="192.0.2.10" autocomplete="off" required>
    </div>
    <button type="submit" class="opg-primary-button">Request IP</button>
  </form>
  <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">CIDR networks and ranges are not accepted. Review the requested address in Pending IPs before approval.</p>
</section>
{% endblock %}
