{% extends 'layouts/auth.html.twig' %}
{% block title %}{{ section_title }}{% endblock %}
{% block content %}
<div class="opg-shell min-h-screen lg:flex" x-data="adminShell" data-settings-active="{{ active_section|default('') in ['security', 'google', 'smtp'] ? '1' : '0' }}">
  <div class="opg-backdrop" x-show="backdropVisible" x-on:click="closeSidebar" x-cloak aria-hidden="true"></div>
  <aside id="admin-sidebar" class="opg-sidebar" x-ref="sidebar" x-bind:class="sidebarClass" aria-label="Main navigation" tabindex="-1">
    <div class="opg-sidebar-header flex h-20 shrink-0 items-center justify-between gap-3 border-b border-gray-200 px-6 dark:border-gray-800">
      <a class="inline-flex items-center gap-3 font-semibold text-gray-900 dark:text-white" href="{{ workspace_home|default('/admin') }}">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-500 text-lg font-bold text-white" aria-hidden="true">O</span>
        <span class="text-xl tracking-tight">OPGateway</span>
      </a>
      <button type="button" class="opg-icon-button lg:hidden" x-on:click="closeSidebar" aria-label="Close navigation">
        <svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-x"></use></svg>
      </button>
    </div>
    <div class="opg-sidebar-scroll min-h-0 flex-1 overflow-y-auto" role="region" aria-label="Sidebar navigation and information" tabindex="0">
    {% block sidebar_navigation %}{% endblock %}
    <div class="border-t border-gray-200 px-6 py-4 text-xs leading-5 text-gray-500 dark:border-gray-800 dark:text-gray-400">
      {% block sidebar_note %}Managed API access · Private operator area{% endblock %}
    </div>
  </div>
  </aside>
  <div class="min-w-0 flex-1 lg:ms-[18rem]">
    <header class="opg-main-header sticky top-0 z-20 flex h-20 shrink-0 items-center justify-between gap-4 border-b border-gray-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8 dark:border-gray-800 dark:bg-gray-900/95">
      <div class="flex min-w-0 items-center gap-3">
        <button type="button" class="opg-icon-button lg:hidden" x-on:click="openSidebar" x-bind:aria-expanded="sidebarOpen" aria-controls="admin-sidebar" aria-label="Open navigation"><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-menu"></use></svg></button>
        <div class="min-w-0">
          <p class="hidden text-xs font-medium tracking-wide text-gray-500 sm:block dark:text-gray-400">OPGateway / {{ workspace_name|default('Administration') }}</p>
          <h1 class="truncate text-sm font-semibold text-gray-900 sm:text-lg dark:text-white">{{ section_title }}</h1>
        </div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <button type="button" class="opg-icon-button opg-theme-toggle" x-on:click="cycleTheme" x-bind:aria-label="themeControlLabel" x-bind:title="themeControlLabel" aria-label="Change color theme" title="Change color theme">
          <svg viewBox="0 0 24 24" class="opg-icon opg-theme-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-monitor"></use></svg>
          <svg viewBox="0 0 24 24" class="opg-icon opg-theme-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-sun"></use></svg>
          <svg viewBox="0 0 24 24" class="opg-icon opg-theme-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-moon"></use></svg>
          <span class="opg-sr-only" x-text="themeLabel">System</span>
        </button>
        <div class="hidden max-w-48 truncate text-sm font-medium text-gray-700 sm:block dark:text-gray-300">{{ user_label|default(administrator_label|default('Administrator')) }}</div>
        <form method="post" action="{{ logout_path|default('/admin/logout') }}">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}">
          <button type="submit" class="opg-icon-button" aria-label="Sign out" title="Sign out"><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-log-out"></use></svg></button>
        </form>
      </div>
    </header>
    <main id="main-content" class="mx-auto w-full min-w-0 max-w-screen-2xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
      {% block dashboard_content %}{% endblock %}
      <footer class="pb-5 pt-8 text-center text-xs text-gray-500 dark:text-gray-400">{{ workspace_footer|default('OPGateway · Security-sensitive administrator workspace') }}</footer>
    </main>
  </div>
</div>
{% block workspace_overlays %}{% endblock %}
{% endblock %}
