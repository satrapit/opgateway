{% extends 'layouts/auth.html.twig' %}
{% block title %}{{ page_title }}{% endblock %}
{% block content %}
<div class="grid min-h-screen lg:grid-cols-2" x-data="adminShell">
  <main id="main-content" class="relative flex min-w-0 items-center justify-center px-4 py-16 sm:px-8 lg:px-12">
    <button type="button" class="opg-icon-button opg-theme-toggle absolute end-4 top-4 sm:end-6 sm:top-6" x-on:click="cycleTheme" x-bind:aria-label="themeControlLabel" x-bind:title="themeControlLabel" aria-label="Change color theme" title="Change color theme">
        <svg viewBox="0 0 24 24" class="opg-icon opg-theme-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-monitor"></use></svg>
        <svg viewBox="0 0 24 24" class="opg-icon opg-theme-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-sun"></use></svg>
        <svg viewBox="0 0 24 24" class="opg-icon opg-theme-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-moon"></use></svg>
        <span class="opg-sr-only" x-text="themeLabel">System</span>
      </button>
    <div class="w-full max-w-md min-w-0">
      <a href="/account/login" class="mb-10 inline-flex items-center gap-3 no-underline">
        <span class="flex size-11 items-center justify-center rounded-xl bg-brand-500 text-xl font-bold text-white" aria-hidden="true">O</span>
        <span class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">OPGateway</span>
      </a>
      <p class="mb-2 text-sm font-semibold text-brand-600 dark:text-brand-300">{{ page_eyebrow }}</p>
      <h1 class="mb-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">{{ page_title }}</h1>
      <p class="mb-8 text-sm leading-6 text-gray-500 dark:text-gray-400">{{ page_description }}</p>
      {% block account_form %}{% endblock %}
    </div>
  </main>
  <aside class="hidden items-center justify-center bg-brand-950 px-12 text-white lg:flex" aria-label="About the gateway">
    <div class="max-w-md">
      <div class="mb-8 flex size-16 items-center justify-center rounded-2xl bg-brand-500 text-3xl font-bold shadow-lg">O</div>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-brand-200">OPGateway</p>
      <h2 class="mb-5 text-4xl font-semibold leading-tight">Your account.<span class="block text-brand-300">Your API access.</span></h2>
      <p class="max-w-sm leading-7 text-brand-100">Manage your Openprovider account, clients and IP addresses.</p>
      <div class="mt-9 flex flex-wrap gap-3 text-sm">
        <span class="rounded-full border border-brand-300/40 px-4 py-2">Account access</span>
        <span class="rounded-full border border-brand-300/40 px-4 py-2">API clients</span>
      </div>
    </div>
  </aside>
</div>
{% endblock %}
