{% extends 'layouts/workspace.html.twig' %}
{% block sidebar_navigation %}
    <nav class="space-y-1 px-4 py-6" aria-label="Administrator sections">
      <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-widest text-gray-400">Workspace</p>
      <a class="opg-nav-link" href="/admin"{% if active_section == 'overview' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-layout-dashboard"></use></svg> Overview</a>
      <p class="px-3 pb-2 pt-6 text-xs font-semibold uppercase tracking-widest text-gray-400">Account management</p>
      <a class="opg-nav-link" href="/admin/users"{% if active_section == 'users' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-user-check"></use></svg> User approvals</a>
      <a class="opg-nav-link" href="/admin/owners"{% if active_section == 'owners' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-users"></use></svg> Account owners</a>
      <p class="px-3 pb-2 pt-6 text-xs font-semibold uppercase tracking-widest text-gray-400">API access</p>
      <a class="opg-nav-link" href="/admin/clients"{% if active_section == 'clients' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-server"></use></svg> API clients</a>
      <a class="opg-nav-link" href="/admin/ips/pending"{% if active_section == 'pending_ips' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-clock"></use></svg> Pending IPs</a>
      <a class="opg-nav-link" href="/admin/ips/approved"{% if active_section == 'approved_ips' %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-shield-check"></use></svg> Approved IPs</a>
      <p class="px-3 pb-2 pt-6 text-xs font-semibold uppercase tracking-widest text-gray-400">System</p>
      <button type="button" class="opg-nav-link opg-nav-parent w-full text-start{{ active_section in ['security','google','smtp'] ? ' opg-nav-parent-active' : '' }}"
        x-on:click="toggleSettingsMenu" x-bind:aria-expanded="settingsMenuOpen"
        aria-controls="opg-settings-submenu">
        <svg viewBox="0 0 24 24" class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-settings"></use></svg>
        <span class="min-w-0 flex-1">Settings</span>
        <svg viewBox="0 0 24 24" class="opg-icon opg-nav-chevron" aria-hidden="true" focusable="false" x-bind:class="settingsChevronClass"><use href="{{ admin_assets.icons }}#opg-icon-chevron-down"></use></svg>
      </button>
      <div id="opg-settings-submenu" class="opg-nav-submenu"
        x-bind:class="settingsSubmenuClass" x-bind:aria-hidden="settingsMenuHidden"
        x-bind:inert="settingsMenuHidden">
        <div class="opg-nav-submenu-inner">
          <a class="opg-nav-sublink" href="/admin/settings/security"{% if active_section == 'security' %} aria-current="page"{% endif %}>Security</a>
          <a class="opg-nav-sublink" href="/admin/settings/login/google"{% if active_section == 'google' %} aria-current="page"{% endif %}>Google SSO</a>
          <a class="opg-nav-sublink" href="/admin/settings/smtp"{% if active_section == 'smtp' %} aria-current="page"{% endif %}>Email / SMTP</a>
        </div>
      </div>
    </nav>
{% endblock %}

{% block workspace_overlays %}
{% include 'components/admin-dialogs.html.twig' %}
{% endblock %}
