{% extends 'layouts/auth.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block content %}
<div class="opg-shell min-h-screen lg:flex" x-data="adminShell">
  <div class="opg-backdrop" x-show="backdropVisible" x-on:click="closeSidebar" x-cloak aria-hidden="true"></div>
  <aside id="admin-sidebar" class="opg-sidebar" x-ref="sidebar" x-bind:class="sidebarClass" aria-label="Main navigation" tabindex="-1">
    <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-6 py-6 dark:border-gray-800">
      <a class="inline-flex items-center gap-3 font-semibold text-gray-900 dark:text-white" href="/admin#overview">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-500 text-lg font-bold text-white" aria-hidden="true">O</span>
        <span class="text-xl tracking-tight">OPGateway</span>
      </a>
      <button type="button" class="opg-icon-button lg:hidden" x-on:click="closeSidebar" aria-label="Close navigation">
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <nav class="space-y-1 px-4 py-6" aria-label="Administrator sections">
      <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-widest text-gray-400">Workspace</p>
      <a class="opg-nav-link" href="#overview" aria-current="page"><span aria-hidden="true">▦</span> Overview</a>
      <a class="opg-nav-link" href="#users"><span aria-hidden="true">◉</span> User approvals</a>
      <a class="opg-nav-link" href="#owners"><span aria-hidden="true">♙</span> Account owners</a>
      <a class="opg-nav-link" href="#clients"><span aria-hidden="true">▤</span> API clients</a>
      <a class="opg-nav-link" href="#pending-ips"><span aria-hidden="true">◎</span> Pending IPs</a>
      <a class="opg-nav-link" href="#approved-ips"><span aria-hidden="true">◈</span> Approved IPs</a>
    </nav>
    <div class="mt-auto border-t border-gray-200 px-6 py-4 text-xs leading-5 text-gray-500 dark:border-gray-800 dark:text-gray-400">
      Managed API access · Private operator area
    </div>
  </aside>
  <div class="min-w-0 flex-1 lg:ms-[18rem]">
    <header class="sticky top-0 z-20 flex min-h-20 items-center justify-between gap-4 border-b border-gray-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8 dark:border-gray-800 dark:bg-gray-900/95">
      <div class="flex min-w-0 items-center gap-3">
        <button type="button" class="opg-icon-button lg:hidden" x-on:click="openSidebar" x-bind:aria-expanded="sidebarOpen" aria-controls="admin-sidebar" aria-label="Open navigation"><span aria-hidden="true">☰</span></button>
        <div class="min-w-0">
          <p class="text-xs font-medium tracking-wide text-gray-500 dark:text-gray-400">OPGateway / Administration</p>
          <h1 class="truncate text-lg font-semibold text-gray-900 dark:text-white">Workspace overview</h1>
        </div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <button type="button" class="opg-icon-button min-w-24" x-on:click="cycleTheme" aria-label="Change color theme" title="Change color theme"><span x-text="themeLabel">System</span></button>
        <div class="hidden max-w-48 truncate text-sm font-medium text-gray-700 sm:block dark:text-gray-300">{{ administrator_label }}</div>
        <form method="post" action="/admin/logout">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}">
          <button type="submit" class="opg-secondary-button">Sign out</button>
        </form>
      </div>
    </header>
    <main id="main-content" class="mx-auto w-full max-w-screen-2xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
      {% block dashboard_content %}{% endblock %}
      <footer class="pb-5 pt-8 text-center text-xs text-gray-500 dark:text-gray-400">OPGateway · Security-sensitive administrator workspace</footer>
    </main>
  </div>
</div>
{% endblock %}
