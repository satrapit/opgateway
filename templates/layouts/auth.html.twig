<!doctype html>
<html lang="en" dir="ltr" data-theme="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="{% block referrer_policy %}same-origin{% endblock %}">
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}OPGateway{% endblock %} | OPGateway</title>
  {# Icons are browser-rendered SVG; preload the same-origin shared sprite. #}
  <link rel="preload" href="{{ admin_assets.icons }}" as="image" type="image/svg+xml">
  <link rel="preload" href="{{ admin_assets.app_js }}" as="script">
  <script src="{{ admin_assets.theme_init }}"></script>
  <link rel="stylesheet" href="{{ admin_assets.app_css }}">
</head>
<body class="min-h-screen bg-gray-50 font-outfit text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
  <a class="opg-skip-link" href="#main-content">Skip to content</a>
  {% block content %}{% endblock %}
  <script src="{{ admin_assets.app_js }}" defer></script>
</body>
</html>
