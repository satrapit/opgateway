{# Native dialogs are inert until local JavaScript enhances records/forms.
   No dynamic HTML insertion, secrets, URLs or application state are embedded. #}
<dialog id="opg-record-dialog" class="opg-dialog" aria-labelledby="opg-record-dialog-title">
  <div class="opg-dialog-inner">
    <header class="opg-dialog-header">
      <div><p class="opg-dialog-eyebrow">Record information</p><h2 id="opg-record-dialog-title" class="opg-dialog-title">Record details</h2></div>
      <button type="button" class="opg-icon-button" data-opg-close-dialog aria-label="Close record details" title="Close"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-x"></use></svg></button>
    </header>
    <div id="opg-record-dialog-body" class="opg-dialog-body"></div>
    <footer class="opg-dialog-footer"><button type="button" class="opg-secondary-button" data-opg-close-dialog>Close</button></footer>
  </div>
</dialog>
<dialog id="opg-provision-dialog" class="opg-dialog" aria-labelledby="opg-provision-dialog-title" aria-describedby="opg-provision-dialog-description">
  <div class="opg-dialog-inner">
    <header class="opg-dialog-header">
      <div><p class="opg-dialog-eyebrow">Client administration</p><h2 id="opg-provision-dialog-title" class="opg-dialog-title">New request</h2></div>
      <button type="button" class="opg-icon-button" data-opg-close-dialog aria-label="Close request form" title="Close"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-x"></use></svg></button>
    </header>
    <div class="opg-dialog-body">
      <p id="opg-provision-dialog-description" class="opg-dialog-help"></p>
      <div id="opg-provision-dialog-body"></div>
    </div>
    <footer class="opg-dialog-footer"><button type="button" class="opg-secondary-button" data-opg-close-dialog>Cancel</button></footer>
  </div>
</dialog>
<dialog id="opg-confirm-dialog" class="opg-dialog" aria-labelledby="opg-confirm-dialog-title" aria-describedby="opg-confirm-dialog-description">
  <div class="opg-dialog-inner">
    <header class="opg-dialog-header">
      <div><p class="opg-dialog-eyebrow">Sensitive access change</p><h2 id="opg-confirm-dialog-title" class="opg-dialog-title">Confirm action</h2></div>
      <button type="button" class="opg-icon-button" data-opg-close-dialog aria-label="Cancel access change" title="Cancel"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-x"></use></svg></button>
    </header>
    <div class="opg-dialog-body">
      <p id="opg-confirm-dialog-description" class="opg-dialog-help"></p>
      <p id="opg-confirm-dialog-target" class="opg-confirm-target"></p>
      <p class="opg-dialog-note">Your action is still verified by the server, including role, IP, CSRF and rate limits.</p>
    </div>
    <footer class="opg-dialog-footer">
      <button type="button" class="opg-secondary-button" data-opg-close-dialog>Keep access</button>
      <button type="button" class="opg-danger-button" data-opg-confirm-submit><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-shield-alert"></use></svg> Confirm change</button>
    </footer>
  </div>
</dialog>
