{# All form names match strict server-side decoders. No permission decisions are made here. #}
{% macro review(csrf, action, target_id, title, destructive = false, target = '') %}
<form method="post" action="/admin/review" class="inline-flex" {% if destructive %}data-confirm="Confirm {{ title }}? This change may immediately affect access." data-confirm-target="{{ target }}"{% endif %}>
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <input type="hidden" name="action" value="{{ action }}">
  <input type="hidden" name="target_id" value="{{ target_id }}">
  <button type="submit" class="{{ destructive ? 'opg-danger-button' : 'opg-small-button' }}">
    <svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-{{ action == 'disable_client' ? 'ban' : (action == 'revoke_ip' ? 'shield-x' : 'check') }}"></use></svg>
    {{ title }}
  </button>
  {% if destructive %}<noscript><span class="opg-muted">This access change takes effect immediately when submitted.</span></noscript>{% endif %}
</form>
{% endmacro %}

{% macro provision(csrf, action, target_id, title, label, placeholder, maxlength = 128, variant = 'desktop') %}
<form method="post" action="/admin/provision" class="opg-provision-form" data-opg-provision data-opg-dialog-title="{{ title }}">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <input type="hidden" name="action" value="{{ action }}">
  <input type="hidden" name="target_id" value="{{ target_id }}">
  <label class="opg-sr-only" for="opg-{{ variant }}-{{ action }}-{{ target_id }}">{{ label }}</label>
  <input class="opg-small-input" id="opg-{{ variant }}-{{ action }}-{{ target_id }}" name="value" type="text" maxlength="{{ maxlength }}" placeholder="{{ placeholder }}" required>
  <button type="submit" class="opg-small-button"><svg class="opg-icon" aria-hidden="true" focusable="false"><use href="{{ admin_assets.icons }}#opg-icon-plus"></use></svg> {{ title }}</button>
</form>
{% endmacro %}
