{% macro review(csrf_token, action_name, target_id, label, destructive = false) %}
<form method="post" action="/admin/review" class="inline-flex" {% if destructive %}data-confirm="{{ label }}? This change affects API access."{% endif %}>
  <input type="hidden" name="_csrf" value="{{ csrf_token }}">
  <input type="hidden" name="action" value="{{ action_name }}">
  <input type="hidden" name="target_id" value="{{ target_id }}">
  <button type="submit" class="min-h-11 rounded-lg border px-3 py-2 text-xs font-semibold transition-colors focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-500 {{ destructive ? 'border-red-200 text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-300' : 'border-brand-200 text-brand-700 hover:bg-brand-50 dark:border-brand-800 dark:text-brand-300' }}">{{ label }}</button>
</form>
{% endmacro %}

{% macro provision(csrf_token, action_name, target_id, field_label, button_label, max_length) %}
{% set field_id = 'provision-' ~ action_name ~ '-' ~ target_id %}
<form method="post" action="/admin/provision" class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-end">
  <input type="hidden" name="_csrf" value="{{ csrf_token }}">
  <input type="hidden" name="action" value="{{ action_name }}">
  <input type="hidden" name="target_id" value="{{ target_id }}">
  <div class="min-w-0 flex-1">
    <label for="{{ field_id }}" class="mb-1 block text-xs font-medium text-gray-600 dark:text-gray-300">{{ field_label }}</label>
    <input id="{{ field_id }}" name="value" type="text" maxlength="{{ max_length }}" required autocomplete="off" class="min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-800 focus:border-brand-500 focus:outline-3 focus:outline-brand-500/20 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
  </div>
  <button type="submit" class="min-h-11 shrink-0 rounded-lg bg-brand-500 px-4 py-2 text-xs font-semibold text-white hover:bg-brand-600 focus-visible:outline-3 focus-visible:outline-brand-500">{{ button_label }}</button>
</form>
{% endmacro %}
