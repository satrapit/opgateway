{
  "name": "opgateway-admin-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-only TailAdmin Free-compatible static assets for the OPGateway administrator UI",
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production",
    "build:dev": "webpack --config webpack.config.cjs --mode development",
    "check": "node --check src/js/admin.js && node --check src/js/theme-init.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@alpinejs/csp": "3.17.5"
  }
}
