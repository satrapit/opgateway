# Place the real .env outside Document Root; never commit secrets.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://opgateway.example.com
APP_KEY=
TRUSTED_PROXIES=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opgateway
DB_USER=opgateway
DB_PASSWORD=
OPENPROVIDER_ENV=production
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
GATEWAY_PROXY_ENABLED=false
# The installer is disabled by default and requires operator-only activation.
SETUP_ENABLED=false
SETUP_ALLOWED_IP=
SETUP_TOKEN_HASH=
# The browser admin UI is separately disabled until admin setup and review.
ADMIN_UI_ENABLED=false
ADMIN_UI_ALLOWED_IP=
# Exactly 64 lowercase hex digits from 32 cryptographically random bytes.
# Leave empty until intentional enablement; never reuse APP_KEY or setup token.
LOGIN_RATE_LIMIT_KEY=
