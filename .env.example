# Copy to .env and store outside public document root.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://opgateway.example.com
APP_KEY=
TRUSTED_PROXIES=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opgateway
DB_USER=opgateway
DB_PASSWORD=
OPENPROVIDER_ENV=production
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
GATEWAY_PROXY_ENABLED=false
# Operator-only bootstrap is disabled unless explicitly enabled in private .env.
# Never commit a setup token, its SHA-256 digest or any real IP address.
SETUP_ENABLED=false
SETUP_ALLOWED_IP=
SETUP_TOKEN_HASH=
