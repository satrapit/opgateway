# Place the real .env outside Document Root; never commit secrets.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://opgateway.example.com
APP_KEY=
TRUSTED_PROXIES=
DB_HOST=db
DB_PORT=3306
DB_NAME=opgateway
DB_USER=opgateway
DB_PASSWORD=
OPENPROVIDER_ENV=production
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
GATEWAY_PROXY_ENABLED=false
ADMIN_UI_ENABLED=false
ACCOUNT_UI_ENABLED=false
ACCOUNT_KEYS_ENABLED=false
ADMIN_ACTIONS_ENABLED=false
ADMIN_TWIG_UI_ENABLED=false
# ADMIN_UI_ALLOWED_IP has been retired. Login uses HTTPS, host validation,
# throttling, server sessions, CSRF and fresh database role checks instead.
ADMIN_SMTP_SETTINGS_ENABLED=false
ACCOUNT_REGISTRATION_ENABLED=false
ACCOUNT_INTEGRATION_ENABLED=false
GATEWAY_PROXY_WRITE_ENABLED=false
LOGIN_RATE_LIMIT_KEY=
