# Copy to .env, then place it outside the document root (public/).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://opgateway.example.com
# Generate a random secret locally; never commit it.
APP_KEY=
# Never trust X-Forwarded-For unless REMOTE_ADDR matches an exact trusted proxy IP.
TRUSTED_PROXIES=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opgateway
DB_USER=opgateway
DB_PASSWORD=
# Only one provider environment is active in an application instance.
OPENPROVIDER_ENV=production
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
# Default deny: no upstream operations are enabled during foundation phase.
GATEWAY_PROXY_ENABLED=false
