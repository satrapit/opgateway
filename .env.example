# Place the real .env outside Document Root; never commit secrets.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://opgateway.example.com
APP_KEY=
TRUSTED_PROXIES=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opgateway
DB_USER=opgateway
DB_PASSWORD=
# Optional Medoo PDO socket transport; blank uses DB_HOST and DB_PORT.
DB_UNIX_SOCKET=
# Temporary operator-only routed Medoo connection test; never leave enabled.
DB_CONNECTION_TEST_ENABLED=false
DB_CONNECTION_TEST_ALLOWED_IP=
OPENPROVIDER_ENV=production
OPENPROVIDER_BASE_URL=https://api.openprovider.eu/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
GATEWAY_PROXY_ENABLED=false
SETUP_ENABLED=false
SETUP_ALLOWED_IP=
SETUP_TOKEN_HASH=
# Generate 32 random bytes encoded as 64 lowercase hex characters.
# Use an independent key; never reuse APP_KEY, setup token or login key.
SETUP_RATE_LIMIT_KEY=
ADMIN_UI_ENABLED=false
ADMIN_UI_ALLOWED_IP=
LOGIN_RATE_LIMIT_KEY=
